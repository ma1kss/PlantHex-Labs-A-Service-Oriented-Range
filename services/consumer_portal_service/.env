CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8006

# Must match iam-service so the edge can validate IAM-issued JWTs.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# Static fallback endpoints when the registry can't resolve a service.
DOWNSTREAM_FALLBACK=iam-service=http://localhost:8001,scenario-service=http://localhost:8002,events-service=http://localhost:8004,monitoring-service=http://localhost:8005

CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8009

DATABASE_URL=postgresql+asyncpg://sor:sor@localhost:5432/sor

# Must match iam-service so we can validate its tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# Peers it coordinates (registry preferred; this is the fallback).
DOWNSTREAM_FALLBACK=scenario-service=http://sor_scenario:8002,iam-service=http://sor_iam:8001,learning-service=http://sor_learning:8008,monitoring-service=http://sor_monitoring:8005

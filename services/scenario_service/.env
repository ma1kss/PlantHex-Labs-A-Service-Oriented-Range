CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8002

DATABASE_URL=postgresql+asyncpg://sor:sor@localhost:5432/sor

# Local dir for challenge files when running outside Docker. In compose this
# is overridden to /data/challenges (mounted volume).
CHALLENGE_FILES_DIR=./challenge_files

# Must match iam-service so we can validate its tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# docker challenge runtime
# Comma-separated FROM allow-list. "*" disables (lab only).
DOCKER_ALLOWED_BASE_IMAGES=ubuntu:22.04,ubuntu:latest,alpine:latest,alpine:3.20,debian:bookworm-slim,python:3.11-slim,python:3.12-slim,nginx:1.27-alpine
# Hostname trainees use to reach their session containers.
PLAYER_SESSION_HOSTNAME=localhost
# Bridge network player containers join. Created on startup if missing.
DOCKER_PLAYER_NETWORK=sor_chal_net
# Cleanup loop tick.
DOCKER_CLEANUP_INTERVAL_SECONDS=60

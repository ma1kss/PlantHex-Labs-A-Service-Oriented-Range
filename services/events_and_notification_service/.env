CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8004

DATABASE_URL=postgresql+asyncpg://sor:sor@localhost:5432/sor

# Must match iam-service so we can validate its tokens (HTTP + WebSocket).
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# Per-service queue bound to cyber_range.events (#) for the event-log consumer.
EVENTS_QUEUE=events-service.log

CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8005

# Must match iam-service so we can validate its tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# Prometheus / Grafana locations.
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PUBLIC_URL=http://localhost:9090
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_DASHBOARD_UID=sor-overview

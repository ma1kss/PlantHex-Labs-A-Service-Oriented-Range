CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8007

# Must match iam-service so we can validate its tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# Unified store.
OPENSEARCH_HOSTS=http://localhost:9200

# Durable queue bound to cyber_range.events (#) for the capture consumer.
DATA_QUEUE=data-logging.capture

CONSUL_HOST=localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PUBLIC_HOSTNAME=host.docker.internal
PORT=8008

DATABASE_URL=postgresql+asyncpg://sor:sor@localhost:5432/sor

# Must match iam-service so we can validate its tokens.
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=cyber-range-iam

# CTF points policy (by difficulty).
POINTS_EASY=10
POINTS_MEDIUM=20
POINTS_HARD=30
POINTS_DEFAULT=10

# Durable queue bound to scenario.flag.submitted.
LEARNING_QUEUE=learning-service.scoring
